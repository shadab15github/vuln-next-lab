# Template only — contains no credentials.
#
# The app runs fine without any of these. They exist so you can optionally
# exercise the secret-exposure routes (GET /api/debug, /admin) with values you
# control. Copy this file to apps/web/.env and fill in THROWAWAY values only.
#
#   cp .env.example apps/web/.env
#
# Never put a real credential in this project. It is deliberately vulnerable and
# every one of these values is readable by any unauthenticated visitor through
# GET /api/debug (V-API-43) and path traversal (V-API-16).

NODE_ENV=development

# Placeholder application secrets. The lab's working JWT-forging exploit uses
# the hardcoded fallback in packages/auth (JWT_SECRET = "secret123"), not this.
JWT_SECRET=
SESSION_SECRET=
ADMIN_API_KEY=

DATABASE_URL=
REDIS_URL=

# Third-party keys — leave blank. Filling these in means handing them to anyone
# who can reach the app.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
STRIPE_SECRET_KEY=
SENDGRID_API_KEY=
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=

# V-ENV-02 (CWE-200): anything prefixed NEXT_PUBLIC_ is inlined into the browser
# bundle. This is the planted misconfiguration — the variable names are the
# finding, the values stay empty.
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_INTERNAL_API=http://billing.internal.vulnlab.test/api
