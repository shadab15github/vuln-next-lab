{
  "name": "vuln-next-lab",
  "private": true,
  "version": "0.1.0",
  "description": "INTENTIONALLY VULNERABLE Next.js monorepo for security training and scanner benchmarking. Do not deploy.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vulnlab/web",
    "build": "npm run build --workspace @vulnlab/web",
    "start": "npm run start --workspace @vulnlab/web",
    "audit": "npm audit",
    "audit:json": "npm audit --json"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "handlebars": "4.7.9",
    "minimist": "1.2.6",
    "node-fetch": "2.6.7",
    "js-yaml": "3.13.1",
    "moment": "2.29.4",
    "postcss": "8.5.18",
    "qs": "6.14.1",
    "semver": "5.7.2",
    "xml2js": "0.5.0",
    "follow-redirects": "1.16.0",
    "cookie": "0.7.0"
  },
  "resolutions": {
    "handlebars": "4.7.9",
    "minimist": "1.2.6",
    "node-fetch": "2.6.7",
    "js-yaml": "3.13.1",
